// WTS data model. See BUILD_LOG.md / master prompt Section 5 for the spec
// this was built against.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Core identity — User carries both our own app fields and the fields
// Auth.js's Prisma adapter expects (emailVerified, image), so the same
// table serves both. Account/Session/VerificationToken below are Auth.js's
// standard schema, required as-is for the adapter to work.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  ownedProjects    Project[]     @relation("ProjectOwner")
  ownedInitiatives Initiative[]  @relation("InitiativeOwner")
  ownedWorkstreams Workstream[]  @relation("WorkstreamOwner")
  assignedTasks    Task[]        @relation("TaskAssignee")
  reportedTasks    Task[]        @relation("TaskReporter")
  ownedRisks       Risk[]        @relation("RiskOwner")
  ownedIncidents   Incident[]    @relation("IncidentOwner")
  comments         Comment[]
  activityEvents   ActivityEvent[]
  preferences      UserPreferences?
  inboxItems       InboxItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])

  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/** Per-user preferences — theme, working hours. Replaces the old singleton
 * Settings row now that WTS is multi-user; profile fields (name, email,
 * picture) come from the Google account instead of being editable here. */
model UserPreferences {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme             String  @default("dark") // dark | light | system
  workingHoursStart String  @default("09:00")
  workingHoursEnd   String  @default("18:00")
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Structure: Initiatives -> Projects -> Workstreams -> Tasks
// ---------------------------------------------------------------------------

enum ProjectStatus {
  BACKLOG
  PLANNED
  IN_PROGRESS
  AT_RISK
  BLOCKED
  COMPLETED
}

enum Health {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  BLOCKED
}

enum Priority {
  P0
  P1
  P2
  P3
}

model Initiative {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  ownerId     String?
  owner       User?     @relation("InitiativeOwner", fields: [ownerId], references: [id])
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects Project[]
}

model Project {
  id           String        @id @default(cuid())
  key          String        @unique
  name         String
  description  String?
  status       ProjectStatus @default(PLANNED)
  health       Health        @default(ON_TRACK)
  priority     Priority      @default(P2)
  ownerId      String?
  owner        User?         @relation("ProjectOwner", fields: [ownerId], references: [id])
  initiativeId String?
  initiative   Initiative?   @relation(fields: [initiativeId], references: [id])
  startDate    DateTime?
  targetDate   DateTime?
  archived     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workstreams  Workstream[]
  tasks        Task[]
  risks        Risk[]
  meetings     Meeting[]
  documents    Document[]
  incidents    Incident[]
  followUps    FollowUp[]
  waitingFor   WaitingForItem[]
  releases     ReleaseProject[]
  vendors      VendorProject[]
  activityEvents ActivityEvent[]

  @@index([archived, status])
  @@index([ownerId])
  @@index([initiativeId])
  @@index([updatedAt])
}

model Workstream {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  ownerId     String?
  owner       User?    @relation("WorkstreamOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())

  tasks Task[]
}

// ---------------------------------------------------------------------------
// Tasks (both engineering-style project work and the PM's own operational
// work share this entity, distinguished by `type`)
// ---------------------------------------------------------------------------

enum TaskType {
  TASK
  FEATURE
  BUG
  IMPROVEMENT
  TECH_DEBT
  RESEARCH
  ANALYTICS
  FOLLOW_UP
  MEETING
  CALL
  COMMUNICATION
  REMINDER
  VENDOR
  INCIDENT
  DECISION
  DOCUMENTATION
  IDEA
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  WAITING
  BLOCKED
  DONE
}

enum PlanBucket {
  MUST_DO
  SHOULD_DO
  IF_TIME
}

enum DependencyType {
  BLOCKS
  BLOCKED_BY
  DEPENDS_ON
  RELATES_TO
  DUPLICATES
}

model Task {
  id           String     @id @default(cuid())
  taskKey      String     @unique
  title        String
  description  String?
  type         TaskType   @default(TASK)
  status       TaskStatus @default(TODO)
  priority     Priority   @default(P2)
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id])
  workstreamId String?
  workstream   Workstream? @relation(fields: [workstreamId], references: [id])
  assigneeId   String?
  assignee     User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reporterId   String?
  reporter     User?      @relation("TaskReporter", fields: [reporterId], references: [id])
  parentTaskId String?
  parentTask   Task?      @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Restrict)
  subtasks     Task[]     @relation("Subtasks")
  dueDate      DateTime?
  startDate    DateTime?
  estimate     Float?
  labels       String?    // comma-separated
  isPersonal   Boolean    @default(false) // PM's own operational work vs project work
  planBucket   PlanBucket?
  planDate     DateTime?
  planOrder    Int        @default(0)

  // fintech-specific, optional/conditional fields
  paymentGateway String?
  paymentMethod  String?
  network        String?
  transactionType String?
  merchant       String?
  environment    String?
  errorCode      String?
  failureReason  String?
  transactionVolume Float?
  successRate    Float?

  personId  String?
  person    Person? @relation(fields: [personId], references: [id])
  vendorId  String?
  vendor    Vendor? @relation(fields: [vendorId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  comments      Comment[]
  attachments   Attachment[]
  activityEvents ActivityEvent[]
  dependenciesFrom TaskDependency[] @relation("DependencyFrom")
  dependenciesTo   TaskDependency[] @relation("DependencyTo")
  meetingActionItems ActionItem[]
  followUps     FollowUp[]
  waitingFor    WaitingForItem[]

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([status, dueDate])
  @@index([parentTaskId])
  @@index([workstreamId])
  @@index([reporterId])
  @@index([personId])
  @@index([vendorId])
  @@index([planDate])
}

model TaskDependency {
  id         String         @id @default(cuid())
  fromTaskId String
  fromTask   Task           @relation("DependencyFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTaskId   String
  toTask     Task           @relation("DependencyTo", fields: [toTaskId], references: [id], onDelete: Cascade)
  type       DependencyType
  createdAt  DateTime       @default(now())

  @@unique([fromTaskId, toTaskId, type])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model Attachment {
  id        String   @id @default(cuid())
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  documentId String?
  document  Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileName  String
  filePath  String
  fileSize  Int?
  mimeType  String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// People & Vendors
// ---------------------------------------------------------------------------

enum PersonCategory {
  ENGINEERING
  DESIGN
  FINANCE
  OPERATIONS
  LEADERSHIP
  SALES
  LEGAL
  COMPLIANCE
  VENDOR
  EXTERNAL
  OTHER
}

model Person {
  id             String         @id @default(cuid())
  name           String
  role           String?
  department     String?
  company        String?
  email          String?
  phone          String?
  avatar         String?
  category       PersonCategory @default(OTHER)
  notes          String?
  lastInteraction DateTime?
  nextFollowUp   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tasks       Task[]
  followUps   FollowUp[]
  waitingFor  WaitingForItem[]
  interactions Interaction[]
  meetings    MeetingParticipant[]
}

model Interaction {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  note      String
  channel   String?
  date      DateTime @default(now())
}

enum VendorStatus {
  ACTIVE
  EVALUATING
  INACTIVE
}

model Vendor {
  id             String       @id @default(cuid())
  name           String
  category       String?
  description    String?
  website         String?
  primaryContact String?
  email          String?
  phone          String?
  notes          String?
  status         VendorStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tasks      Task[]
  followUps  FollowUp[]
  waitingFor WaitingForItem[]
  meetings   MeetingVendor[]
  projects   VendorProject[]
  incidents  Incident[]
}

model VendorProject {
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([vendorId, projectId])
}

// ---------------------------------------------------------------------------
// Follow-ups & Waiting For
// ---------------------------------------------------------------------------

enum FollowUpChannel {
  EMAIL
  PHONE
  WHATSAPP
  SLACK
  MEETING
  OTHER
}

enum FollowUpStatus {
  TO_CONTACT
  CONTACTED
  WAITING_FOR_RESPONSE
  FOLLOW_UP_DUE
  RESOLVED
  CLOSED
}

model FollowUp {
  id             String          @id @default(cuid())
  topic          String
  personId       String?
  person         Person?         @relation(fields: [personId], references: [id])
  vendorId       String?
  vendor         Vendor?         @relation(fields: [vendorId], references: [id])
  lastContactDate DateTime?
  followUpDate   DateTime?
  status         FollowUpStatus  @default(TO_CONTACT)
  priority       Priority        @default(P2)
  channel        FollowUpChannel @default(EMAIL)
  relatedProjectId String?
  relatedProject Project?        @relation(fields: [relatedProjectId], references: [id])
  relatedTaskId  String?
  relatedTask    Task?           @relation(fields: [relatedTaskId], references: [id])
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, followUpDate])
  @@index([personId])
  @@index([vendorId])
}

enum WaitingForStatus {
  WAITING
  FOLLOW_UP_DUE
  RECEIVED
  CANCELLED
}

model WaitingForItem {
  id            String           @id @default(cuid())
  who           String
  personId      String?
  person        Person?          @relation(fields: [personId], references: [id])
  vendorId      String?
  vendor        Vendor?          @relation(fields: [vendorId], references: [id])
  what          String
  projectId     String?
  project       Project?         @relation(fields: [projectId], references: [id])
  taskId        String?
  task          Task?            @relation(fields: [taskId], references: [id])
  since         DateTime         @default(now())
  expectedDate  DateTime?
  followUpDate  DateTime?
  status        WaitingForStatus @default(WAITING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, followUpDate])
  @@index([personId])
  @@index([vendorId])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Meetings, Risks
// ---------------------------------------------------------------------------

model Meeting {
  id            String   @id @default(cuid())
  title         String
  date          DateTime
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])
  agenda        String?
  notes         String?
  googleEventId String?  @unique // set when imported from Google Calendar, prevents re-importing
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants MeetingParticipant[]
  actionItems  ActionItem[]
  vendors      MeetingVendor[]

  @@index([date])
  @@index([projectId])
}

model MeetingParticipant {
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  personId  String
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([meetingId, personId])
}

model MeetingVendor {
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([meetingId, vendorId])
}

model ActionItem {
  id          String   @id @default(cuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  description String
  ownerName   String?
  dueDate     DateTime?
  convertedTaskId String?
  convertedTask   Task? @relation(fields: [convertedTaskId], references: [id])
  createdAt   DateTime @default(now())
}

enum RiskStatus {
  MONITORING
  MITIGATED
  ESCALATED
  CLOSED
}

model Risk {
  id          String     @id @default(cuid())
  risk        String
  description String?
  probability Int        @default(2) // 1-5
  impact      Int        @default(2) // 1-5
  ownerId     String?
  owner       User?      @relation("RiskOwner", fields: [ownerId], references: [id])
  mitigation  String?
  dueDate     DateTime?
  status      RiskStatus @default(MONITORING)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId, status])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Releases, Documents, Incidents
// ---------------------------------------------------------------------------

enum ReleaseStatus {
  PLANNED
  IN_PROGRESS
  TESTING
  SHIPPED
  DELAYED
}

model Release {
  id         String        @id @default(cuid())
  name       String
  version    String?
  targetDate DateTime?
  status     ReleaseStatus @default(PLANNED)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  projects ReleaseProject[]
}

model ReleaseProject {
  releaseId String
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([releaseId, projectId])
}

enum DocumentType {
  PRD
  BRD
  MEETING_NOTES
  RESEARCH
  PRODUCT_DECISION
  RELEASE_NOTES
  REQUIREMENTS
  NOTES
}

model Document {
  id        String       @id @default(cuid())
  title     String
  type      DocumentType @default(NOTES)
  content   String       @default("")
  projectId String?
  project   Project?     @relation(fields: [projectId], references: [id])
  // PRD template fields (nullable, only used when type = PRD)
  prdProblem          String?
  prdBackground        String?
  prdGoals             String?
  prdNonGoals          String?
  prdUserStories       String?
  prdRequirements      String?
  prdAcceptanceCriteria String?
  prdSuccessMetrics    String?
  prdRisks             String?
  prdDependencies      String?
  prdRolloutPlan       String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  attachments Attachment[]

  @@index([projectId])
}

enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  MONITORING
  RESOLVED
}

model Incident {
  id          String           @id @default(cuid())
  incidentKey String           @unique
  title       String
  severity    IncidentSeverity @default(SEV3)
  status      IncidentStatus   @default(OPEN)
  startTime   DateTime         @default(now())
  endTime     DateTime?
  impact      String?
  rootCause   String?
  resolution  String?
  postmortem  String?
  ownerId     String?
  owner       User?            @relation("IncidentOwner", fields: [ownerId], references: [id])
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id])
  vendorId    String?
  vendor      Vendor?          @relation(fields: [vendorId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// ---------------------------------------------------------------------------
// Activity log
// ---------------------------------------------------------------------------

model ActivityEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  entityType String   // "Task" | "Project" | ...
  entityId   String
  action     String   // e.g. "status_changed", "created", "archived"
  message    String   // human-readable, e.g. "moved TASK-123 to In Progress"
  fromValue  String?
  toValue    String?
  createdAt  DateTime @default(now())

  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([taskId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Inbox — rapid capture, triaged into other entities
// ---------------------------------------------------------------------------

enum InboxConversion {
  TASK
  FOLLOW_UP
  REMINDER
  MEETING
  RESEARCH
  IDEA
}

model InboxItem {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  text          String
  converted     Boolean          @default(false)
  convertedType InboxConversion?
  convertedTaskId String?
  createdAt     DateTime         @default(now())

  @@index([userId, converted])
}

