# Template — placeholder values only, safe to commit. Real values go in
# .env.local (gitignored, never committed) or as environment variables in
# your Vercel project settings.

# Supabase Postgres. In the Supabase dashboard: Project Settings > Database
# > Connection string. DATABASE_URL should be the "Transaction" pooler URI
# (port 6543, ?pgbouncer=true) — used at runtime, works with serverless.
# DIRECT_URL should be the "Session"/direct URI (port 5432) — used only for
# running migrations, which need a non-pooled connection.
# Project ref poeyuvwlobsuowdxlfoa filled in below — just needs the real
# password from Project Settings > Database.
DATABASE_URL="postgresql://postgres.poeyuvwlobsuowdxlfoa:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.poeyuvwlobsuowdxlfoa.supabase.co:5432/postgres"

# Auth.js — generate a real secret with: npx auth secret
AUTH_SECRET="replace-with-a-real-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud OAuth app (Gmail + Calendar APIs enabled). See
# BUILD_LOG.md for the step-by-step setup.
GOOGLE_CLIENT_ID="replace-with-your-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-client-secret"

# Optional — AI features degrade gracefully without this.
OPENAI_API_KEY=""
